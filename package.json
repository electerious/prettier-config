{
  "name": "@electerious/prettier-config",
  "version": "5.0.0",
  "description": "Prettier configuration for my personal projects",
  "keywords": [
    "prettier",
    "config",
    "format",
    "formatter"
  ],
  "homepage": "https://github.com/electerious/prettier-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electerious/prettier-config.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "eslint": "eslint \"**/*.js\"",
    "format": "npm run eslint -- --fix && npm run prettier -- --write",
    "lint": "npm run eslint && npm run prettier -- --check",
    "prettier": "prettier --ignore-path .gitignore \"**/*.{js,json,md,yml}\"",
    "test": "npm run lint && node --test"
  },
  "prettier": "./src/index.js",
  "dependencies": {
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2"
  },
  "devDependencies": {
    "@electerious/eslint-config": "^6.0.0-rc.4",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "authors": [
    "Tobias Reich <tobias@electerious.com>"
  ]
}
